{
  "name": "mozzarella",
  "version": "2.1.0",
  "description": "A cheezy-simple hook based immutable store for React",
  "keywords": [
    "hooks",
    "immer",
    "react-hooks",
    "react",
    "state",
    "state-management",
    "store",
    "typescript"
  ],
  "author": "Kilian Ciuffolo <kilian.ciuffolo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kilianc/mozzarella.git"
  },
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.5",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "immer": "11.1.16",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-compare": "3.2.2",
    "redux": "5.0.1",
    "tinybench": "6.1.3",
    "ts-jest": "29.4.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "zustand": "5.0.14"
  },
  "peerDependencies": {
    "immer": ">=6.0.0",
    "react": ">=16.8.0",
    "react-fast-compare": ">=3.0.0"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint --max-warnings=0",
    "format": "prettier --write .",
    "build:esm": "tsc -p tsconfig-esm.json && node scripts/write-module-type.mjs esm",
    "build:cjs": "tsc -p tsconfig-cjs.json && node scripts/write-module-type.mjs cjs",
    "build": "rm -rf lib && npm run build:esm && npm run build:cjs",
    "test": "jest",
    "bench": "npm run build && node bench/index.mjs"
  }
}
